#We now have two candidate models SARIMA(0,1,1)(0,1,1)[12] and SARIMA(0,1,2)(0,1,1)[12]. We fit both of them and see which one is better using RMSE and Ljung-Box Test
#Now we fit a SARIMA(0,1,1)(0,1,1)(12) model
model1 <- arima(avg_temp_train1, order = c(0,1,1),
seasonal = list(order = c(0,1,1), period = 12))
Box.test(residuals(model1), lag = 12, type = "Ljung")
# Parameters
n <- 100
phi <- 0.8
c <- 0.5
# Simulate AR(1) process
# arima.sim generates stationary processes;
# the constant 'c' implies a non-zero mean = c/(1-phi)
ts_data <- arima.sim(model = list(ar = c(phi)), n = n)
# Add mean and plot
ts_data <- ts_data + c / (1 - phi)
plot(ts_data, main = paste("AR(1) Simulation (phi =", phi, ")"))
kpss.test(ts_data)
kpss.test(ts_data, nulll=c("Level"))
kpss.test(ts_data, null=c("Level"))
