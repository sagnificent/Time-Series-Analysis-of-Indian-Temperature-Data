#Loading metadata
hourlyLoadDataIndia <- read_excel("Datasets/hourlyLoadDataIndia.xlsx")
library(readxl)
library(tidyverse)
library(zoo)
library(forecast)
library(lmtest)
library(MASS)
library(here)
library(dplyr)
library(trend)
library(tseries)
library(Kendall)
#Loading metadata
hourlyLoadDataIndia <- read_excel("Datasets/hourlyLoadDataIndia.xlsx")
#Let us perform a summary statistic of the data
summary(hourlyLoadDataIndia$`National Hourly Demand`)
#For Simplicity, we are referring to the nationwide data and convert it into a TS with frequency 24hrs(one day cycle)
national<-ts(hourlyLoadDataIndia$`National Hourly Demand`, frequency = 24)
plot(national, xlab= "Time in Hours", ylab = "National Load Demand", main = "National Load Demand from 2019 to 2024", col="blue")
#As evident from the plots, they show a clear seasonal pattern with an increasing trend
#Performing a KPSS test to check if its stationary or not
kpss.test(national)
#Judging by the p-value it is a non stationary process
#We will split the train and test from the national data to help in forecasting
sample_size<-floor(0.8*length(national))
train_index<-c(1:sample_size)
national_train<-ts(national[train_index], frequency = 24)
national_test<-ts(national[-train_index], frequency = 24)
national_train1<-ts(national[train_index], frequency = 24)
#We now conduct a Seasonal Mann Kendall Test to check for trend when there is seasonality in the data
smk.test(national_train)
#As indicated by the p-value there is a clear trend in the data. From a visual standpoint, we take it to be an increasing trend
#We now difference the series at lag 24 to remove the seasonal component
national_train<-diff(national_train, lag=24)
national_train<-diff(national_train)
plot(national_train, xlab = "Time in Hours", ylab = "Differenced Demand", main = "Differenced Series(Lag = 24 hours after a lag of 1 hour", col = "blue")
boxplot(national_train)
plot(national_train^2)
acf(national_train^2)
library(FinTS)
install.packages("FinTS")
library(FinTS)
ArchTest(x_diff, lags = 24)kpss.test(national_train)
ArchTest(national_train, lags = 24)kpss.test(national_train)
ArchTest(national_train, lags = 24)
